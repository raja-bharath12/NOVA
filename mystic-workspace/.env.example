# ==========================================
# NOVA — AWS RDS PostgreSQL Configuration
# ==========================================

# AWS RDS Cluster Host
RDSHOST=database-1.cluster-c7ey60g2wfh6.ap-south-1.rds.amazonaws.com
AWS_REGION=ap-south-1

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.cluster-c7ey60g2wfh6.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_rds_password_or_iam_auth_token

# Backend Server
SERVER_PORT=8080

# Security (JWT)
APP_JWT_SECRET=mystic-workspace-super-secret-key-change-me-before-production-0123456789
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# Storage Configuration ('local' or 's3')
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_DIR=./uploads

# AWS S3 Settings (when APP_STORAGE_TYPE=s3)
AWS_S3_BUCKET=mystic-workspace-bucket
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
